# Build from the repository root:
#   docker build -f Dockerfile.test -t mmwb-tests .
# Run the local suite (external integration tests are excluded):
#   docker run --rm mmwb-tests
# Run selected tests by overriding CMD:
#   docker run --rm mmwb-tests pytest tests/infrastructure/test_dename_service.py tests/routers/test_send.py
FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}"

# Native libraries used by OpenCV, pyzbar, and Firebird imports in the bot tests.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libzbar0 \
    libfbclient2 \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Dockerfile ./Dockerfile
COPY pyproject.toml uv.lock ./
COPY bot/pyproject.toml ./bot/
COPY shared/pyproject.toml ./shared/
COPY webapp/pyproject.toml ./webapp/

# Match the production build's minimal workspace layout for dependency caching.
RUN mkdir -p bot/other shared/src/shared webapp && \
    touch bot/__init__.py bot/other/__init__.py && \
    touch shared/src/shared/__init__.py webapp/__init__.py

# The dev group (pytest, Ruff, mypy) is included by default by uv sync.
RUN uv sync --frozen --package mmwb-bot

COPY bot ./bot
COPY shared ./shared
COPY webapp ./webapp

# These are deliberately fake values, matching CI's local test configuration.
ENV BOT_TOKEN=123456:TEST_TOKEN \
    TEST_BOT_TOKEN=123456:TEST_TOKEN \
    ENVIRONMENT=test \
    BASE_FEE=100 \
    DB_URL=sqlite+aiosqlite:////tmp/mmwb-test.db \
    REDIS_URL=redis://127.0.0.1:6379/0 \
    TRON_API_KEY=test \
    TRON_MASTER_ADDRESS=test \
    TRON_MASTER_KEY=test \
    THOTHPAY_API=test \
    OPENAI_KEY=test \
    EURMTL_KEY=test \
    SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0 \
    HORIZON_URL=https://horizon-testnet.stellar.org \
    HORIZON_URL_RW=https://horizon-testnet.stellar.org \
    GRIST_TOKEN=test \
    TONCONSOLE_TOKEN=test \
    TON_TOKEN=test \
    WALLET_COST=1

WORKDIR /app/bot
CMD ["pytest", "tests/", "-m", "not external"]
